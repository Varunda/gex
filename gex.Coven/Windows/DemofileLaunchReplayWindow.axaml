<husk:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:gex.Coven.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="gex.Coven.Windows.DemofileLaunchReplayWindow"
        x:DataType="vm:DemofileLaunchReplayViewModel"
        Title="gex.Coven - Launching replay">

    <StackPanel>
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="*, *, *, *"
              ColumnSpacing="8" RowSpacing="4" VerticalAlignment="Top">

            <Label Grid.Row="0" Grid.Column="0">Game ID</Label>
            <TextBlock Text="{Binding GameID}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0">Engine downloaded?</Label>
            <CheckBox IsChecked="{Binding EngineDownloaded, Mode=OneWay}" Grid.Row="1" Grid.Column="1" IsEnabled="False" />

            <Label Grid.Row="2" Grid.Column="0">Game version downloaded?</Label>
            <CheckBox IsChecked="{Binding GameDownloaded, Mode=OneWay}" Grid.Row="2" Grid.Column="1" IsEnabled="False" />

            <Label Grid.Row="3" Grid.Column="0">Map downloaded?</Label>
            <CheckBox IsChecked="{Binding MapDownloaded, Mode=OneWay}" Grid.Row="3" Grid.Column="1" IsEnabled="False" />
        </Grid>

        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="4,8"
                Command="{Binding CancelLaunch}">
            Cancel
        </Button>
    </StackPanel>

</husk:AppWindow>
