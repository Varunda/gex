<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:gex.Coven.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="using:gex.Coven.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
		xmlns:controls="using:gex.Coven.Controls"
        xmlns:services="using:gex.Coven.Services"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="gex.Coven.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon-32x32.png"
        Title="gex.Coven">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="Gray" Padding="4">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Background="Gray" Foreground="White" 
                            BorderBrush="White" BorderThickness="1"
                            ToolTip.Tip="View logs (hotkey: F2)"
                            Command="{Binding OpenLogs}" HotKey="F2">

                        <TextBlock FontSize="12" Text="Logs"/>
                    </Button>

                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                </DockPanel>
            </Border>
            
            <TabbedPage>
                <ContentPage Header="Matches">
                    <views:MatchListView></views:MatchListView>
                </ContentPage>

                <ContentPage Header="Settings">
                    <views:UserOptionsView></views:UserOptionsView>
                </ContentPage>
            </TabbedPage>
        </DockPanel>

        <ItemsControl x:Name="ToastRoot"
                      ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="16" MaxWidth="360">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1e1e2e" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                            Classes.info="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=INFO}"
                            Classes.warn="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=WARN}"
                            Classes.error="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ERROR}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Vertical">
                                <Border BorderBrush="{StaticResource ControlInteractiveBorderBrush}"
                                        BorderThickness="0,0,0,1" Margin="0,4,0,4">

                                    <TextBlock Text="{Binding Title}" Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               VerticalAlignment="Center">
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           Foreground="White" VerticalAlignment="Center">
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1" Content="x" FontSize="10"
                                    Background="Transparent" Foreground="Gray"
                                    Padding="12" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding #ToastRoot.((vm:MainViewModel)DataContext).Toasts.DismissCommand}"
                                    CommandParameter="{Binding .}">
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>

    </Panel>

</Window>
