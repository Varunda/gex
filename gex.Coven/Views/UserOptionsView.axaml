<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:gex.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:gex.Coven.ViewModels"
             xmlns:ti="using:TablerIcons"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="2000"
             x:DataType="vm:UserOptionsViewModel"
             x:Class="gex.Coven.Views.UserOptionsView"
             x:Name="Root">

    <ScrollViewer Background="{StaticResource OverlayBackgroundBrush}">
        <StackPanel Orientation="Vertical" Margin="0,24,0,24" Spacing="36">

            <husk:Card Padding="24" 
                       HorizontalAlignment="Center"
                       Width="1280" MaxWidth="1280">
                <StackPanel>
                    <TextBlock FontSize="{StaticResource LargeFontSize}"
                               FontWeight="{StaticResource ControlStrongFontWeight}"
                               Padding="0,0,0,12"
                               Text="Install folder">
                    </TextBlock>

                    <TextBlock FontSize="{StaticResource NormalFontSize}"
                               Text="This folder can be found by opening the BAR launcher, and clicking 'Open install directory'"
                               Padding="0,0,0,4"
                               TextWrapping="Wrap">
                    </TextBlock>

                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="4">
                        <TextBox Text="{Binding InstallFolder}" IsReadOnly="True" Grid.Column="0"></TextBox>
                        <Button Command="{Binding OpenReplayFolderDialog}" Grid.Column="1">Select</Button>
                        <Button Command="{Binding OpenReplayFolderExplorer}" Grid.Column="2">Open</Button>
                    </Grid>
                </StackPanel>
            </husk:Card>

            <husk:Card Padding="24" 
                       HorizontalAlignment="Center"
                       Width="1280" MaxWidth="1280">
                <StackPanel>
                    <TextBlock FontSize="{StaticResource LargeFontSize}"
                               FontWeight="{StaticResource ControlStrongFontWeight}"
                               Padding="0,0,0,12"
                               Text="Target user">
                    </TextBlock>

                    <TextBlock FontSize="{StaticResource NormalFontSize}"
                               Text="The user to use when checking for a win or a loss in a match"
                               Padding="0,0,0,4"
                               TextWrapping="Wrap">
                    </TextBlock>

                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="*, *" ColumnSpacing="4" RowSpacing="8">

                        <AutoCompleteBox ItemsSource="{Binding TargetUserOptions}"
                                  Grid.Row="0" Grid.ColumnSpan="3"
                                  PlaceholderText="No target user selected"
                                  FilterMode="Contains"
                                  ValueMemberBinding="{Binding Username}"
                                  SelectedItem="{Binding SelectedTargetUser}"
                                  MinimumPrefixLength="0">
                        </AutoCompleteBox>

                        <!--
                        <ComboBox ItemsSource="{Binding TargetUserOptions}"
                                  PlaceholderText="No target user selected"
                                  Grid.Row="0" Grid.ColumnSpan="3"
                                  SelectedValueBinding="{Binding UserID}"
                                  SelectedValue="{Binding TargetUserId}">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Username}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        -->

                        <Button Command="{Binding RefreshTargetUserOptions}"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Refresh user options">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Reload"/>
                                <ti:TablerIcon Icon="IconReload" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding TargetUserId, StringFormat='User ID: {0}'}"
                                   Grid.Row="1" Grid.Column="1"
                                   VerticalAlignment="Center">
                        </TextBlock>

                        <Button Command="{Binding ClearTargetUserIdCommand}"
                                Grid.Row="1" Grid.Column="2"
                                ToolTip.Tip="Clear the target user ID">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Clear"/>
                                <ti:TablerIcon Icon="IconX" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </husk:Card>

            <husk:Card Padding="24"
                       HorizontalAlignment="Center"
                       Width="1280" MaxWidth="1280">

                <StackPanel MaxHeight="480">
                    <TextBlock FontSize="{StaticResource LargeFontSize}"
                               FontWeight="{StaticResource ControlStrongFontWeight}"
                               Padding="0,0,0,12"
                               Text=".sdfz file association">
                    </TextBlock>

                    <TextBlock FontSize="{StaticResource NormalFontSize}"
                               Text="Will .sdfz files be opened with gex.Coven?"
                               Padding="0,0,0,4"
                               TextWrapping="Wrap">
                    </TextBlock>

                    <husk:Divider/>

                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="8" ColumnSpacing="8">
                        <TextBlock Text="{Binding SdfzAssociated}" VerticalAlignment="Center" Grid.Column="0"/>

                        <Button Command="{Binding AddFileAssociation}" Classes="btn-success" IsEnabled="{Binding IsAdmin}" Grid.Column="1">
                            Add
                        </Button>

                        <Button Command="{Binding RemoveFileAssociation}" Classes="btn-danger" IsEnabled="{Binding IsAdmin}" Grid.Column="2">
                            Remove
                        </Button>
                    </Grid>

                    <Border CornerRadius="4" Background="{StaticResource ControlWarningBackgroundBrush}">
                        <TextBlock IsVisible="{Binding !IsAdmin}" Padding="4"
                                   Text="This application must be run as an admin to be able to add the file association">
                        </TextBlock>
                    </Border>
                    
                </StackPanel>
            </husk:Card>

            <husk:Card Padding="24"
                       HorizontalAlignment="Center"
                       Width="1280" MaxWidth="1280">

                <StackPanel MaxHeight="480" Spacing="12">
                    <TextBlock FontSize="{StaticResource LargeFontSize}"
                               FontWeight="{StaticResource ControlStrongFontWeight}"
                               Padding="0,0,0,12"
                               Text="Version">
                    </TextBlock>

                    <husk:Divider />

                    <ToggleSwitch Content="Check for updates" IsChecked="{Binding VersionCheckUpdates}"/>

                    <TextBlock Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                               Text="Will gex.Coven check for updates on startup?">
                    </TextBlock>

                    <ToggleSwitch Content="Auto update" IsChecked="{Binding VersionAutoUpdate}"/>

                    <TextBlock Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                               Text="Will gex.Coven automatically download and update itself on startup?">
                    </TextBlock>

                    <Button HorizontalAlignment="Left">
                        Check for updates
                    </Button>
                        
                </StackPanel>
            </husk:Card>

            <husk:Card Padding="24"
                       HorizontalAlignment="Center"
                       Width="1280" MaxWidth="1280">

                <StackPanel MaxHeight="480">
                    <TextBlock FontSize="{StaticResource LargeFontSize}"
                               FontWeight="{StaticResource ControlStrongFontWeight}"
                               Padding="0,0,0,12"
                               Text="Ignored demofiles">
                    </TextBlock>

                    <TextBlock FontSize="{StaticResource NormalFontSize}"
                               Text="These demofiles are ignored by Coven, usually because they are duplicate demofiles, or could not be parsed"
                               Padding="0,0,0,4"
                               TextWrapping="Wrap">
                    </TextBlock>

                    <TableView MaxHeight="380" ItemsSource="{Binding IgnoredFiles}" Margin="0,0,0,8"
                               Background="{StaticResource ControlInteractiveBackgroundBrush}"
                               VerticalAlignment="Center">

                        <TableView.Columns>
                            <TableViewColumn Header="Filename" Binding="{Binding FileName}" Width="40*"></TableViewColumn>

                            <TableViewColumn Header="Reason" Width="40*">
                                <TableViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" ToolTip.Tip="{Binding Reason}"/>
                                    </DataTemplate>
                                </TableViewColumn.CellTemplate>
                            </TableViewColumn>

                            <TableViewColumn Header="Unignore" Width="10*">
                                <TableViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button ToolTip.Tip="Unignore this file"
                                            Command="{Binding #Root.((vm:UserOptionsViewModel)DataContext).RemoveIgnoredFile}"
                                            CommandParameter="{Binding .}">

                                            <ti:TablerIcon Icon="IconTrash"
                                                           Width="16" Height="16">
                                            </ti:TablerIcon>
                                        </Button>
                                    </DataTemplate>
                                </TableViewColumn.CellTemplate>
                                
                            </TableViewColumn>
                        </TableView.Columns>
                    </TableView>

                    <TextBlock Text="{Binding IgnoredFiles.Count, StringFormat='Ignoring {0} files'}"/>
                    
                </StackPanel>
            </husk:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
