<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:gex.Coven.Controls">

    <Design.PreviewWith>
        <StackPanel Width="400" Spacing="10">
            <StackPanel Background="{DynamicResource SystemRegionBrush}">
                <controls:FactionImage />
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:FactionImage}"
                  TargetType="controls:FactionImage">
        <Setter Property="Template">
            <ControlTemplate>
                <Image x:Name="PART_Image" Width="24" Height="24"></Image>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
