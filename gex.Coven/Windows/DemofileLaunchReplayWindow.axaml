<husk:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="gex.Coven.Windows.DemofileLaunchReplayWindow"
        Title="gex.Coven - Launching replay">

    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="12" ColumnSpacing="12" Margin="12">

        <TextBlock Text="Engine" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"></TextBlock>
        <ProgressBar Grid.Column="1" Grid.Row="0" Value="0" Height="24"></ProgressBar>
        
    </Grid>

</husk:AppWindow>
