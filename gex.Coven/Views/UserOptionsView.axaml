<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:gex.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:gex.Coven.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:UserOptionsViewModel"
             x:Class="gex.Coven.Views.UserOptionsView">

    <StackPanel Orientation="Vertical">

        <Label Content="Replay folder"/>
        <TextBlock Text="{Binding ReplayFolder}"></TextBlock>

        <Button Command="{Binding OpenReplayFolderDialog}">Open</Button>
        
    </StackPanel>

</UserControl>
