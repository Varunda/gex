<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:gex.Coven.Controls"
             xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
             x:Class="gex.Coven.App"
             xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             xmlns:local="using:gex.Coven"
             xmlns:ti="using:TablerIcons"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

        <ControlTheme x:Key="{x:Type ti:TablerIcon}" TargetType="ti:TablerIcon">
            <Setter Property="Brush" Value="{StaticResource ControlForegroundBrush}"/>
        </ControlTheme>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <husk:HuskuiTheme />

        <Style>
            <Style.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Controls/DateTimeView.axaml"/>
                        <ResourceInclude Source="/Controls/FactionImage.axaml"/>
                        <ResourceInclude Source="/Controls/MatchWindow/MatchWindowChat.axaml"/>
                        <ResourceInclude Source="/Controls/MapNameImage.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Style.Resources>
        </Style>

        <Style Selector="ContentPresenter">
            <Setter Property="FontFamily" Value="fonts:Coven#Atkinson Hyperlegible Regular"></Setter>
            <Setter Property="FontSize" Value="16"></Setter>
        </Style>

        <Style Selector="ContentPresenter.pb3">
            <Setter Property="Padding" Value="0,0,0,10"></Setter>
        </Style>

        <Style Selector="Border.info">
            <Setter Property="BorderBrush" Value="{StaticResource ControlSuccessInteractiveBorderBrush}"/>
        </Style>
        <Style Selector="Border.warn">
            <Setter Property="BorderBrush" Value="{StaticResource ControlWarningInteractiveBorderBrush}"/>
        </Style>
        <Style Selector="Border.error">
            <Setter Property="BorderBrush" Value="{StaticResource ControlDangerInteractiveBorderBrush}"/>
        </Style>

        <Style Selector="TableView.Border TableViewRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="TableView.BorderSecondary TableViewRow">
            <Setter Property="BorderBrush" Value="{StaticResource ControlSecondaryForegroundBrush}"/>
        </Style>

        <Style Selector="TableView.BorderAccent TableViewRow">
            <Setter Property="BorderBrush" Value="{StaticResource ControlAccentForegroundBrush}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{StaticResource ControlAccentBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.btn-primary:hover">
            <Setter Property="Background" Value="{StaticResource ControlAccentInteractiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlAccentInteractiveBorderBrush}"/>
        </Style>

        <Style Selector="Button.btn-success">
            <Setter Property="Background" Value="{StaticResource ControlSuccessBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.btn-warning">
            <Setter Property="Background" Value="{StaticResource ControlWarningBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{StaticResource ControlDangerBackgroundBrush}"/>
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="4,8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="16"/>
        </Style>

    </Application.Styles>
</Application>